// ============================================================
// PARLIAMENTARY SESSION TRACKING
// ============================================================

enum SessionType {
  ORDINARY
  EXTRAORDINARY
  EMERGENCY
}

enum SessionStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

model ParliamentarySession {
  id            String         @id @default(uuid())
  sessionNumber String         @unique @map("session_number")
  title         String
  sessionType   SessionType    @map("session_type")
  startDate     DateTime       @map("start_date")
  endDate       DateTime?      @map("end_date")
  status        SessionStatus  @default(UPCOMING)
  readingStages ReadingStage[]
