  ALLOW
}

enum SuspiciousType {
  BRUTE_FORCE
  UNUSUAL_LOCATION
  MASS_EXPORT
  PRIVILEGE_ESCALATION
  OFF_HOURS_ACCESS
}

model UserSession {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation("UserSessions", fields: [userId], references: [id])
  sessionToken   String    @unique
  deviceInfo     Json      @default("{}")
  ipAddress      String?
  userAgent      String?
  isActive       Boolean   @default(true)
  lastActivityAt DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  revokedById    String?
  createdAt      DateTime  @default(now())

  @@index([userId])
  @@map("user_sessions")
}

model LoginHistory {
  id         String    @id @default(uuid())
  userId     String?
  user       User?     @relation("LoginHistory", fields: [userId], references: [id])
  email      String
  ipAddress  String?
  userAgent  String?
  success    Boolean
  failReason String?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([email])
  @@index([ipAddress])
  @@map("login_history")
}

model IpRestriction {
  id          String     @id @default(uuid())
  ipAddress   String
  type        IpRuleType @default(BLOCK)
  reason      String?
  isActive    Boolean    @default(true)
  createdById String
  createdBy   User       @relation("IpRestrictionCreator", fields: [createdById], references: [id])
  expiresAt   DateTime?
  createdAt   DateTime   @default(now())

  @@unique([ipAddress, type])
  @@map("ip_restrictions")
}

model SuspiciousActivity {
  id           String         @id @default(uuid())
  userId       String?
  email        String?
  ipAddress    String?
  activityType SuspiciousType
  details      Json
  riskScore    Float
  isResolved   Boolean        @default(false)
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime       @default(now())

  @@map("suspicious_activities")
}

// ============================================================
// CLASSIFICATION AND CONFIDENTIALITY
// ============================================================

enum ClassificationLevel {
  UNCLASSIFIED
  RESTRICTED
  CONFIDENTIAL
  SECRET
  TOP_SECRET
}

model ContentClassification {
  id                  String             @id @default(uuid())
  legislativeItemId   String             @unique
  legislativeItem     LegislativeItem    @relation(fields: [legislativeItemId], references: [id])
  classificationLevel ClassificationLevel @default(UNCLASSIFIED)
  sensitiveFlags      String[]           @default([])
  classifiedById      String
  classifiedBy        User               @relation("Classifier", fields: [classifiedById], references: [id])
  classifiedAt        DateTime           @default(now())
  reviewDueDate       DateTime?
  declassifiedById    String?
  declassifiedBy      User?              @relation("Declassifier", fields: [declassifiedById], references: [id])
  declassifiedAt      DateTime?
  justification       String?
  updatedAt           DateTime           @updatedAt

  @@map("content_classifications")
}

model AccessException {
  id                String   @id @default(uuid())
  legislativeItemId String
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  grantedById       String
  grantedBy         User     @relation("ExceptionGrantor", fields: [grantedById], references: [id])
  reason            String
  expiresAt         DateTime
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  @@unique([legislativeItemId, userId])
  @@map("access_exceptions")
}

// ============================================================
// DATA RETENTION AND ARCHIVAL
// ============================================================

enum RetentionAction {
  ARCHIVE
  DELETE
  EXPORT_AND_DELETE
}

model RetentionRule {
  id             String          @id @default(uuid())
  name           String          @unique
  entityType     String
  condition      Json
  action         RetentionAction
  retentionYears Int             @default(7)
  isActive       Boolean         @default(true)
  createdById    String
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("retention_rules")
}

model LegalHold {
  id           String    @id @default(uuid())
  entityType   String
  entityId     String
  reason       String
  heldById     String
  heldBy       User      @relation("LegalHoldCreator", fields: [heldById], references: [id])
  isActive     Boolean   @default(true)
  expiresAt    DateTime?
  releasedById String?
  releasedBy   User?     @relation("LegalHoldRelease", fields: [releasedById], references: [id])
  releasedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([entityType, entityId])
  @@map("legal_holds")
}

model ArchivedItem {
  id            String   @id @default(uuid())
  entityType    String
  entityId      String   @unique
  archivedData  Json
  archiveReason String
  archivedById  String
  archivedBy    User     @relation("ArchiveCreator", fields: [archivedById], references: [id])
  restoredAt    DateTime?
  restoredById  String?
  archivedAt    DateTime @default(now())

  @@map("archived_items")
}

// ============================================================
// ADVANCED AUDIT LOGGING
// ============================================================

model ImmutableAuditEntry {
  id             String    @id @default(uuid())
  sequenceNumber Int       @unique
  eventType      String
  actorId        String?
  actorEmail     String?
  entityType     String
  entityId       String
  action         String
  payload        Json
  ipAddress      String?
  userAgent      String?
  previousHash   String?
  entryHash      String
  retainUntil    DateTime?
  createdAt      DateTime  @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("immutable_audit_entries")
}

model AuditRetentionPolicy {
  id            String   @id @default(uuid())
  entityType    String   @unique
  retentionDays Int
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("audit_retention_policies")
}

// ============================================================
// API INTEGRATION FRAMEWORK
// ============================================================

enum IntegrationAuthType {
  API_KEY
  BEARER_TOKEN
  BASIC_AUTH
  OAUTH2
  NONE
}

enum LogDirection {
  OUTBOUND
  INBOUND
}

model ExternalIntegration {
  id              String              @id @default(uuid())
  name            String              @unique
  description     String?
  baseUrl         String
  authType        IntegrationAuthType @default(API_KEY)
  authConfig      Json                @default("{}")
  headers         Json                @default("{}")
  isActive        Boolean             @default(true)
  webhooks        WebhookSubscription[]
  integrationLogs IntegrationLog[]
  createdById     String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@map("external_integrations")
}

model WebhookSubscription {
  id              String              @id @default(uuid())
  integrationId   String
  integration     ExternalIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  eventType       String
  targetUrl       String
  secret          String?
  isActive        Boolean             @default(true)
  maxRetries      Int                 @default(3)
  lastTriggeredAt DateTime?
  createdAt       DateTime            @default(now())

  @@map("webhook_subscriptions")
}

model IntegrationLog {
  id              String               @id @default(uuid())
  integrationId   String?
  integration     ExternalIntegration? @relation(fields: [integrationId], references: [id])
  eventType       String
  direction       LogDirection         @default(OUTBOUND)
  payload         Json
  responseStatus  Int?
  responseBody    Json?
  success         Boolean              @default(false)
  errorMessage    String?
  retryCount      Int                  @default(0)
  targetUrl       String?
  createdAt       DateTime             @default(now())

  @@map("integration_logs")
}

model InboundWebhook {
  id           String    @id @default(uuid())
  source       String
  eventType    String
  payload      Json
  headers      Json      @default("{}")
  processed    Boolean   @default(false)
  processedAt  DateTime?
  errorMessage String?
  createdAt    DateTime  @default(now())

  @@map("inbound_webhooks")
}
