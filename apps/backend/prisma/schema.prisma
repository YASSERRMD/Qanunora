// ============================================================
// LEGAL OPINION MANAGEMENT
// ============================================================

enum OpinionStatus {
  REQUESTED
  ASSIGNED
  DRAFTING
  UNDER_REVIEW
  APPROVED
  ISSUED
  WITHDRAWN
}

model LegalOpinion {
  id                String              @id @default(uuid())
  referenceNumber   String              @unique @map("reference_number")
  subject           String
  requestedById     String              @map("requested_by_id")
  requestedBy       User                @relation("OpinionRequester", fields: [requestedById], references: [id])
