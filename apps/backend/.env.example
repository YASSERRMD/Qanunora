# =============================================================================
# Qanunora Backend — Environment Variables
# Copy to .env and fill in all values before running
# =============================================================================

# Application
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL via Prisma)
DATABASE_URL=postgresql://qanunora:change_me_in_production@localhost:5432/qanunora?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me_in_production

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads

# S3-Compatible Storage (optional, set STORAGE_PROVIDER=s3 to enable)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# =============================================================================
# AI Providers (configure at least one)
# =============================================================================

AI_DEFAULT_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Google Gemini
GOOGLE_AI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Mistral
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# Cohere
COHERE_API_KEY=
COHERE_MODEL=command-r-plus

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Together AI
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# OpenAI-Compatible Custom Endpoint
CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=

# Email (for notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@qanunora.gov
