apiVersion: v1
kind: Secret
metadata:
  name: qanunora-secrets
  namespace: qanunora
  labels:
    app.kubernetes.io/name: qanunora
type: Opaque
stringData:
  # Database
  DATABASE_URL: "postgresql://qanunora_user:CHANGE_ME@postgres:5432/qanunora_db"

  # JWT
  JWT_SECRET: "CHANGE_ME_STRONG_JWT_SECRET_AT_LEAST_64_CHARS"
  JWT_REFRESH_SECRET: "CHANGE_ME_STRONG_REFRESH_SECRET_AT_LEAST_64_CHARS"

  # Encryption (for credentials stored in DB)
  ENCRYPTION_SECRET: "CHANGE_ME_STRONG_ENCRYPTION_SECRET_32_CHARS"

  # Redis
  REDIS_URL: "redis://:CHANGE_ME@redis:6379"

  # AI Providers (optional)
  OPENAI_API_KEY: "sk-CHANGE_ME"
  ANTHROPIC_API_KEY: "sk-ant-CHANGE_ME"

  # Email (optional)
  SMTP_HOST: "smtp.example.com"
  SMTP_PORT: "587"
  SMTP_USER: "noreply@qanunora.gov"
  SMTP_PASS: "CHANGE_ME"

  # Storage (optional)
  S3_BUCKET: "qanunora-documents"
  S3_REGION: "me-south-1"
  S3_ACCESS_KEY_ID: "CHANGE_ME"
  S3_SECRET_ACCESS_KEY: "CHANGE_ME"
