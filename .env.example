# PostgreSQL
POSTGRES_USER=qanunora
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=qanunora
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=change_me_in_production
REDIS_PORT=6379

# Ports
BACKEND_PORT=3001
FRONTEND_PORT=3000
